# Ejemplo de /etc/magilus/respaldo.env (respaldo nocturno de Gestion).
# Copiar al servidor, llenar los valores reales y protegerlo:
#   sudo install -m 600 -o root -g root respaldo.env.example /etc/magilus/respaldo.env
# NUNCA subir este archivo con valores reales al repositorio.
# Los valores con caracteres especiales (comillas, espacios, $, JSON) van entre comillas simples.

# --- Base de datos de produccion (usuario de SOLO LECTURA gestion_respaldo) ---
PGHOST=postgres
PGPORT=5432
PGDATABASE=gestion
PGUSER=gestion_respaldo
PGPASSWORD='cambiar'
# Red de Docker desde la que se llega a Postgres (la red "attachable" del stack de Postgres).
# Vacio = red del servidor (usar PGHOST=127.0.0.1 si Postgres publica el puerto).
RESPALDO_DOCKER_RED=minha_rede
# Imagen de las herramientas de Postgres. Vacio = se detecta sola la version del servidor
# (postgres:<version>-alpine), que es lo que hace falta para que el respaldo sirva al restaurar.
RESPALDO_PG_IMAGEN=

# --- Donde se guardan ---
RESPALDO_DIR=/opt/respaldos/gestion
RESPALDO_DIAS=30
# Espacio libre minimo (MB) en RESPALDO_DIR para empezar.
RESPALDO_MIN_LIBRE_MB=2048
RESPALDO_LOG=/var/log/magilus-respaldo.log
# Tiempo maximo de cada paso (formato de `timeout`: 2h, 90m...). Si se pasa, falla y llega el correo.
RESPALDO_LIMITE=2h

# --- Google Drive (rclone, configurado solo con variables) ---
# Carpeta destino dentro del Drive de Magilus.
RESPALDO_DRIVE_DESTINO=drive:Respaldos/Gestion
RCLONE_CONFIG_DRIVE_TYPE=drive
# drive.file = rclone solo ve los archivos y carpetas que el mismo creo: no puede tocar nada mas del Drive.
RCLONE_CONFIG_DRIVE_SCOPE=drive.file
RCLONE_CONFIG_DRIVE_CLIENT_ID=
RCLONE_CONFIG_DRIVE_CLIENT_SECRET=
# JSON que devuelve `rclone authorize "drive"` (ver README), en una sola linea y entre comillas simples.
RCLONE_CONFIG_DRIVE_TOKEN='{"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}'

# --- Aviso si falla (mismo correo SMTP que usa Gestion) ---
AVISO_CORREO=gestionmagilus@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=gestionmagilus@gmail.com
SMTP_PASS='cambiar'
SMTP_FROM=gestionmagilus@gmail.com
