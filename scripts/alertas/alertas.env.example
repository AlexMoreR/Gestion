# Ejemplo de /etc/magilus/alertas.env (aviso diario de dinero por WhatsApp).
# Copiar al servidor, llenar los valores reales y protegerlo:
#   sudo install -m 600 -o root -g root alertas.env.example /etc/magilus/alertas.env
# NUNCA subir este archivo con valores reales al repositorio.

# --- Gestion ---
# Direccion publica de Gestion (sin / al final).
GESTION_URL=
# Llave de la ruta /api/alertas/dinero: la misma ALERTAS_API_KEY del servicio (o MCP_API_KEY si no hay).
ALERTAS_API_KEY=

# --- WhatsApp (WAHA, linea Admin) ---
WAHA_URL=
WAHA_API_KEY=
# Nombre de la sesion de WAHA de la linea Admin.
WAHA_SESSION=
# Numero de Alexander con indicativo, solo digitos (ej. 57...).
ALERTA_TELEFONO=
