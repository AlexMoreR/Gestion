# /etc/magilus/revisor.env (chmod 600, dueño root). Ejemplo SIN valores reales.
# El SMTP de los correos se toma de /etc/magilus/respaldo.env (el del respaldo nocturno).

# Llave de GET /api/revisor. La misma que se pone en Gestion (docker service update --env-add y
# compose de Portainer). Si Gestion no tiene REVISOR_API_KEY, aqui va su MCP_API_KEY.
REVISOR_API_KEY=

# A quien avisar: Sistemas (Emanuel) recibe lo nuevo; el dueño, lo de plata que sigue desde ayer.
REVISOR_CORREO_SISTEMAS=
REVISOR_CORREO_DUENO=

# Opcionales (valores por defecto):
# REVISOR_URL=https://magilus.com/api/revisor
# REVISOR_DIR=/opt/magilus/revisor
# REVISOR_LOG=/var/log/magilus-revisor.log
