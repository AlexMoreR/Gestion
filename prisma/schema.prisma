generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLEADO
  CLIENTE
}

model User {
  id                       String                @id @default(cuid())
  name                     String?
  email                    String                @unique
  document                 String?
  phone                    String?
  address                  String?
  neighborhood             String?
  department               String?
  city                     String?
  instagram                String?
  tiktok                   String?
  password                 String
  role                     Role                  @default(CLIENTE)
  image                    String?
  emailVerified            DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  quotesAsClient           Quote[]               @relation("QuoteClient")
  quotesCreated            Quote[]               @relation("QuoteCreatedBy")
  salesAsClient            Sale[]                @relation("SaleClient")
  salesCreated             Sale[]                @relation("SaleCreatedBy")
  ordersAsClient           Order[]               @relation("OrderClient")
  ordersCreated            Order[]               @relation("OrderCreatedBy")
  ordersAssigned           Order[]               @relation("OrderAssignedTo")
  productionJobsAssigned   ProductionJob[]       @relation("ProductionJobAssignedTo")
  productionJobsCreated    ProductionJob[]       @relation("ProductionJobCreatedBy")
  dispatchesCreated        Dispatch[]            @relation("DispatchCreatedBy")
  orderStatusChanges       OrderStatusHistory[]  @relation("OrderStatusHistoryChangedBy")
  supplierLedgerEntries    SupplierLedgerEntry[] @relation("SupplierLedgerCreatedBy")
  shippingCostsCreated     ShippingCost[]
  accountsCreated          Account[]             @relation("AccountCreatedBy")
  accountMovements         AccountMovement[]     @relation("AccountMovementCreatedBy")
  expenseCategoriesCreated ExpenseCategory[]     @relation("ExpenseCategoryCreatedBy")
  expensesCreated          Expense[]             @relation("ExpenseCreatedBy")
  expensesAsEmployee       Expense[]             @relation("ExpenseEmployee")
  inventoryMovements       InventoryMovement[]   @relation("InventoryMovementCreatedBy")
  activityLogs             ActivityLog[]         @relation("ActivityLogActor")
  monthClosures            MonthClosure[]        @relation("MonthClosureGeneratedBy")
  shipmentsCreated         Shipment[]            @relation("ShipmentCreatedBy")
  shipmentEvents           ShipmentEvent[]       @relation("ShipmentEventActor")
  salePaymentsCreated      SalePayment[]         @relation("SalePaymentCreatedBy")
  registrosRetroactivos    RegistroRetroactivo[] @relation("RegistroRetroactivoUsuario")
  teamMember               TeamMember?           @relation("TeamMemberUser")
  asistenciaMarcas         AsistenciaMarca[]     @relation("AsistenciaMarcaUsuario")
  asistenciaCreadas        AsistenciaMarca[]     @relation("AsistenciaMarcaCreadaPor")
  gastoBorradores          GastoBorrador[]       @relation("GastoBorradorCreadoPor")
  asistenciaAnuladas       AsistenciaMarca[]     @relation("AsistenciaMarcaAnuladaPor")
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
}

model ActivityLog {
  id         String         @id @default(cuid())
  actorId    String?
  actorName  String
  action     ActivityAction
  entityType String
  entityId   String?
  summary    String
  createdAt  DateTime       @default(now())
  actor      User?          @relation("ActivityLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, createdAt])
  @@index([createdAt])
}

model Product {
  id                 String              @id @default(cuid())
  code               String              @unique
  slug               String              @unique
  name               String
  description        String?
  seoTitle           String?
  seoDescription     String?
  price              Decimal             @db.Decimal(10, 2)
  // Precio normal real (respaldo del tachado en la tienda). NULL = se usa price.
  regularPrice       Decimal?            @db.Decimal(10, 2)
  // Oferta con fechas: la tienda la muestra solo si hoy esta entre promoStartsAt y promoEndsAt
  // y promoPrice < precio normal. Por ahora es solo visual (cotizaciones y ventas usan price).
  promoPrice         Decimal?            @db.Decimal(10, 2)
  promoStartsAt      DateTime?
  promoEndsAt        DateTime?
  baseCost          Decimal             @default(0) @db.Decimal(10, 2)
  // Costo adicional por unidad (ej. flete/transporte de la compra). El costo de
  // compra real del producto = baseCost (proveedor) + additionalCost (flete).
  additionalCost     Decimal             @default(0) @db.Decimal(10, 2)
  retailMarginPct    Decimal             @default(0) @db.Decimal(6, 2)
  wholesaleMarginPct Decimal             @default(0) @db.Decimal(6, 2)
  wholesalePrice     Decimal             @default(0) @db.Decimal(10, 2)
  minWholesaleQty    Int                 @default(6)
  minStock           Int                 @default(0)
  isBundle           Boolean             @default(false)
  // Si es true, el producto no aparece en la tienda principal (catalogo publico).
  hiddenFromStore    Boolean             @default(false)
  // Envio ADICIONAL de este producto (COP). Si es NULL se usa el de su categoria.
  shippingExtra      Int?
  categoryId         String?
  thumbnailUrl       String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  suppliers          ProductSupplier[]
  quoteItems         QuoteItem[]
  orderItems         OrderItem[]
  bundleComponents   ProductComponent[]  @relation("BundleParent")
  partOfBundles      ProductComponent[]  @relation("BundleChild")
  inventoryMovements InventoryMovement[]
  reviews            ProductReview[]
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  authorName String?
  rating     Int
  comment    String
  photoUrl   String?
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductComponent {
  id        String   @id @default(cuid())
  parentId  String
  childId   String
  quantity  Int      @default(1)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  parent    Product  @relation("BundleParent", fields: [parentId], references: [id], onDelete: Cascade)
  child     Product  @relation("BundleChild", fields: [childId], references: [id], onDelete: Restrict)

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  order     Int
  // Fase 6 (sincronizacion con Drive): id del archivo en Drive y de donde viene la foto.
  // origen: "drive" | "servidor". NULL = foto anterior a la sincronizacion.
  driveFileId String?
  origen      String?
  // "foto" = galeria de la tienda (portada, Traer de Drive, API /api/catalogo para NETMAGI y el CRM).
  // "ficha" = ficha tecnica (imagen con nombre, medidas y materiales). Va en su propia seccion y
  // NUNCA sale como foto. Ver src/lib/product-fichas.ts.
  tipo        String   @default("foto")
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Category {
  id             String    @id @default(cuid())
  name           String    @unique
  slug           String    @unique
  description    String?
  seoTitle       String?
  seoDescription String?
  logoUrl        String?
  isActive       Boolean   @default(true)
  shippingExtra  Int? // envio ADICIONAL de los productos de esta categoria (COP); NULL = se cotiza
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]
}

enum SupplierType {
  MANUFACTURER
  SHIPPING
}

model Supplier {
  id                String                @id @default(cuid())
  name              String                @unique
  displayName       String?
  email             String?
  phone             String?
  type              SupplierType          @default(MANUFACTURER)
  shareToken        String?               @unique
  isActive          Boolean               @default(true)
  // Advertencia que se muestra al elegirlo como transportador en un despacho (una idea por linea).
  dispatchWarning   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  products          ProductSupplier[]
  quoteItems        QuoteItem[]
  orderItems        OrderItem[]           @relation("OrderItemConfirmedSupplier")
  ledgerEntries     SupplierLedgerEntry[]
  carriedDispatches Dispatch[]            @relation("DispatchCarrier")
  shippingLegs      DispatchShippingLeg[] @relation("DispatchShippingLegCarrier")
  purchaseOrders    Order[]               @relation("OrderSupplier")
  manufacturingOrders ManufacturingOrder[]
}

enum SupplierLedgerType {
  CHARGE
  PAYMENT
}

model SupplierLedgerEntry {
  id                   String                @id @default(cuid())
  // Código secuencial legible para cargos de inventario (INV-00001...).
  code                 String?               @unique
  supplierId           String
  type                 SupplierLedgerType
  amount               Decimal               @db.Decimal(12, 2)
  saleId               String?
  transactionReference String?
  paymentDate          DateTime?
  note                 String?
  orderId              String?
  orderItemId          String?
  dispatchId           String?
  inventoryMovementId  String?
  // Para abonos (PAYMENT) que saldan un cargo de inventario/manual específico:
  // apunta al SupplierLedgerEntry de tipo CHARGE que paga.
  settlesEntryId       String?
  receiptUrl           String?
  receiptName          String?
  accountId            String?
  createdById          String
  createdAt            DateTime              @default(now())
  supplier             Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  sale                 Sale?                 @relation(fields: [saleId], references: [id], onDelete: SetNull)
  order                Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem            OrderItem?            @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  dispatch             Dispatch?             @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  inventoryMovement    InventoryMovement?    @relation(fields: [inventoryMovementId], references: [id], onDelete: Cascade)
  account              Account?              @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy            User                  @relation("SupplierLedgerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  settlesEntry         SupplierLedgerEntry?  @relation("ChargeSettlement", fields: [settlesEntryId], references: [id], onDelete: Cascade)
  settledByEntries     SupplierLedgerEntry[] @relation("ChargeSettlement")
  // Fletes (costo de envio de la venta) y tramos de despacho que este pago cubre.
  shippingCosts        ShippingCost[]
  shippingLegs         DispatchShippingLeg[]

  @@index([supplierId, createdAt])
  @@index([saleId, createdAt])
  @@index([orderId])
  @@index([orderItemId])
  @@index([dispatchId])
  @@index([inventoryMovementId])
  @@index([accountId])
  @@index([settlesEntryId])
}

model ProductSupplier {
  productId    String
  supplierId   String
  supplierSku  String?
  supplierCost Decimal? @db.Decimal(10, 2)
  isPreferred  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([productId, supplierId])
  @@index([supplierId])
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id          String      @id @default(cuid())
  code        String      @unique
  clientId    String
  createdById String
  status      QuoteStatus @default(DRAFT)
  notes       String?
  validUntil  DateTime?
  subtotal    Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @default(0) @db.Decimal(12, 2)
  shareToken  String      @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  client      User        @relation("QuoteClient", fields: [clientId], references: [id], onDelete: Restrict)
  createdBy   User        @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items       QuoteItem[]
  sale        Sale?
  orders      Order[]
  // Origen del cliente (lo avisa el CRM al marcar GANADO). NULL = sin dato. Se copia a la venta.
  origin       SaleOrigin?
  // Detalle del origen: anuncio, cuenta MK, item de Marketplace, linea, via, etc. Nunca telefonos.
  originDetail Json?

  @@index([clientId, createdAt])
  @@index([createdById, createdAt])
}

// Origen de la venta (decision de Alexander, 7-oct-2026). Sale de la linea de WhatsApp del chat
// en el CRM: Ventas 1 = META_ADS, Ventas 2 = MARKETPLACE, Admin = REFERIDO o RECURRENTE (segun
// si el cliente ya tenia ventas). Venta sin chat = MOSTRADOR. NULL o SIN_DATO = no se sabe.
enum SaleOrigin {
  META_ADS
  MARKETPLACE
  REFERIDO
  RECURRENTE
  MOSTRADOR
  SIN_DATO
}

enum SaleStatus {
  DRAFT
  ACTIVE
  INVOICED
  COMPLETED
  CANCELLED
}

// Forma de pago acordada con el cliente (decision de Alexander, 7-oct-2026).
// ANTICIPO_50_50: 50 % anticipo + 50 % al terminar (envio gratis en ciudades principales).
// CONTRAENTREGA: solo combo de camilla; el envio se cobra.
enum PaymentMethod {
  ANTICIPO_50_50
  CONTRAENTREGA
}

model Sale {
  id                 String                @id @default(cuid())
  code               String                @unique
  quoteId            String                @unique
  clientId           String
  createdById        String
  status             SaleStatus            @default(ACTIVE)
  paymentMethod      PaymentMethod? // NULL = sin definir (ventas viejas)
  downPaymentAmount  Decimal               @default(0) @db.Decimal(12, 2)
  grossTotal         Decimal               @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal               @default(0) @db.Decimal(12, 2)
  paymentReceiptUrl  String
  paymentReceiptName String
  paymentReceiptType String
  paymentReceipts    Json?
  invoiceToken       String                @unique
  subtotal           Decimal               @default(0) @db.Decimal(12, 2)
  total              Decimal               @default(0) @db.Decimal(12, 2)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  quote              Quote                 @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  client             User                  @relation("SaleClient", fields: [clientId], references: [id], onDelete: Restrict)
  createdBy          User                  @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  order              Order?
  salePayments       SalePayment[]
  supplierPayments   SupplierLedgerEntry[]
  shippingCosts      ShippingCost[]
  // Copia del origen de la cotizacion (o MOSTRADOR en venta directa). NULL = sin dato.
  origin             SaleOrigin?
  originDetail       Json?
  // Momento real en que se registro la venta (createdAt se mueve a la fecha que escribe
  // el usuario). NULL = venta vieja, sin dato. Lo pone el codigo al crear; no se edita.
  registradoEn       DateTime?

  @@index([clientId, createdAt])
  @@index([createdById, createdAt])
  @@index([origin])
}

model ShippingCost {
  id                   String   @id @default(cuid())
  saleId               String
  shippingProvider     String
  amount               Decimal  @db.Decimal(12, 2)
  transactionReference String
  paymentDate          DateTime
  accountId            String?
  // Pago al transportador (SupplierLedgerEntry PAYMENT) que cubre este flete. Si esta, la plata
  // sale de la cuenta de ese pago (accountId queda NULL para no restarla dos veces).
  supplierPaymentId    String?
  createdById          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  sale                 Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  account              Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  supplierPayment      SupplierLedgerEntry? @relation(fields: [supplierPaymentId], references: [id], onDelete: SetNull)
  createdBy            User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([saleId, createdAt])
  @@index([createdById, createdAt])
  @@index([accountId])
  @@index([supplierPaymentId])
}

model SalePayment {
  id            String    @id @default(cuid())
  saleId        String
  amount        Decimal   @db.Decimal(12, 2)
  paymentMethod String
  note          String?
  paymentDate   DateTime?
  receiptUrl    String?
  receiptName   String?
  receiptType   String?
  sortOrder     Int       @default(0)
  accountId     String?
  // Retencion en la fuente: lo que el cliente (empresa) se queda y paga a la DIAN a nombre
  // de Magilus. Cuenta como pagado en la venta pero no entra a ninguna cuenta (accountId NULL).
  isWithholding          Boolean @default(false)
  // Numero del certificado de retencion (opcional).
  withholdingCertificate String?
  // Quien registro el abono. NULL = abono viejo, sin dato.
  createdById   String?
  // createdAt = momento real del registro (nunca se sobrescribe); paymentDate = la que escribe el usuario.
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sale          Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  account       Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy     User?     @relation("SalePaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([saleId, sortOrder])
  @@index([accountId])
  @@index([createdById])
  @@index([isWithholding, paymentDate])
}

// Registro retroactivo: venta, abono o gasto con fecha de un dia anterior al dia en que se
// registro (hora Colombia). Guarda quien, cuando de verdad, que fecha puso y por que.
enum TipoRetroactivo {
  VENTA
  ABONO
  GASTO
}

model RegistroRetroactivo {
  id           String          @id @default(cuid())
  tipo         TipoRetroactivo
  // id del registro (Sale.id, SalePayment.id o Expense.id). Sin llave foranea: el log queda aunque se borre.
  registroId   String
  // Dia que puso el usuario (guardado a mediodia UTC).
  fechaPuesta  DateTime
  // Momento real del registro.
  registradoEn DateTime        @default(now())
  usuarioId    String
  motivo       String
  // Monto del registro en ese momento (copia).
  monto        Decimal         @db.Decimal(14, 2)
  creado       DateTime        @default(now())
  usuario      User            @relation("RegistroRetroactivoUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId, registradoEn])
  @@index([tipo, registradoEn])
  @@index([registroId])
}

model QuoteItem {
  id              String                 @id @default(cuid())
  quoteId         String
  productId       String
  supplierId      String?
  quantity        Int                    @default(1)
  unitPrice       Decimal                @db.Decimal(12, 2)
  lineTotal       Decimal                @db.Decimal(12, 2)
  fulfillmentMode ProductFulfillmentMode @default(STOCK)
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  quote           Quote                  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product         Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier        Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  orderItems      OrderItem[]

  @@index([quoteId])
  @@index([productId])
  @@index([supplierId])
}

enum ProductFulfillmentMode {
  STOCK
  MANUFACTURE
  MIXED
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum OrderStatus {
  DRAFT
  RELEASED
  IN_PRODUCTION
  READY_FOR_DISPATCH
  DISPATCHED
  COMPLETED
  CANCELLED
}

// Tipo de orden: venta a cliente (SALE) o compra a proveedor (PURCHASE).
enum OrderType {
  SALE
  PURCHASE
}

enum ProductionJobStatus {
  PENDING
  IN_PROGRESS
  PAUSED
  DONE
  CANCELLED
}

enum DispatchStatus {
  PENDING
  PACKING
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum DeliveryType {
  COUNTER
  PICKUP
  SHIPPING
}

model Order {
  id                    String                @id @default(cuid())
  code                  String                @unique
  type                  OrderType             @default(SALE)
  // Venta/cotizacion/cliente solo aplican a ordenes de venta (SALE).
  saleId                String?               @unique
  quoteId               String?
  clientId              String?
  // Proveedor solo aplica a ordenes de compra (PURCHASE).
  supplierId            String?
  // Codigo de compra (COM-...) que agrupa los movimientos de inventario de esta
  // orden de compra; permite revertir stock/cargos al eliminarla.
  purchaseCode          String?
  createdById           String
  assignedToId          String?
  status                OrderStatus           @default(DRAFT)
  notes                 String?
  internalNotes         String?
  committedAt           DateTime?
  releasedAt            DateTime?
  completedAt           DateTime?
  subtotal              Decimal               @default(0) @db.Decimal(12, 2)
  total                 Decimal               @default(0) @db.Decimal(12, 2)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  sale                  Sale?                 @relation(fields: [saleId], references: [id], onDelete: Restrict)
  quote                 Quote?                @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  client                User?                 @relation("OrderClient", fields: [clientId], references: [id], onDelete: Restrict)
  supplier              Supplier?             @relation("OrderSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy             User                  @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo            User?                 @relation("OrderAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  productionJobs        ProductionJob[]
  dispatches            Dispatch[]
  history               OrderStatusHistory[]
  supplierLedgerEntries SupplierLedgerEntry[]
  manufacturingOrders   ManufacturingOrder[]

  @@index([clientId, createdAt])
  @@index([createdById, createdAt])
  @@index([assignedToId, createdAt])
  @@index([quoteId, createdAt])
  @@index([supplierId, createdAt])
}

model OrderItem {
  id                    String                 @id @default(cuid())
  orderId               String
  quoteItemId           String?                @unique
  productId             String
  quantity              Int
  unitPrice             Decimal                @db.Decimal(12, 2)
  lineTotal             Decimal                @db.Decimal(12, 2)
  fulfillmentMode       ProductFulfillmentMode
  notes                 String?
  confirmedSupplierId   String?
  purchaseCost          Decimal?               @db.Decimal(12, 2)
  confirmedAt           DateTime?
  supplierPaymentStatus String?
  supplierReceiptUrl    String?
  supplierReceiptName   String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  order                 Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quoteItem             QuoteItem?             @relation(fields: [quoteItemId], references: [id], onDelete: SetNull)
  product               Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  confirmedSupplier     Supplier?              @relation("OrderItemConfirmedSupplier", fields: [confirmedSupplierId], references: [id], onDelete: SetNull)
  productionJobs        ProductionJob[]
  dispatchItems         DispatchItem[]
  photos                OrderItemPhoto[]
  supplierLedgerEntries SupplierLedgerEntry[]

  @@index([orderId])
  @@index([productId])
  @@index([confirmedSupplierId])
}

model OrderItemPhoto {
  id          String    @id @default(cuid())
  orderItemId String
  url         String
  name        String?
  createdAt   DateTime  @default(now())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

model ProductionJob {
  id           String              @id @default(cuid())
  code         String              @unique
  orderId      String
  orderItemId  String?
  status       ProductionJobStatus @default(PENDING)
  quantity     Int
  notes        String?
  dueDate      DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  assignedToId String?
  createdById  String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem    OrderItem?          @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  assignedTo   User?               @relation("ProductionJobAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User                @relation("ProductionJobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([orderItemId])
  @@index([assignedToId, createdAt])
}

model Dispatch {
  id                    String                @id @default(cuid())
  code                  String                @unique
  orderId               String
  status                DispatchStatus        @default(PENDING)
  deliveryType          DeliveryType          @default(SHIPPING)
  carrierName           String?
  carrierSupplierId     String?
  shippingCost          Decimal?              @db.Decimal(12, 2)
  shippingReceiptUrl    String?
  shippingReceiptName   String?
  trackingNumber        String?
  trackingPhotoUrl      String?
  trackingPhotoName     String?
  shippingAddress       String?
  notes                 String?
  deliveryPhotoUrl      String?
  deliveryPhotoName     String?
  packedAt              DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  createdById           String
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  order                 Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy             User                  @relation("DispatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  carrierSupplier       Supplier?             @relation("DispatchCarrier", fields: [carrierSupplierId], references: [id], onDelete: SetNull)
  items                 DispatchItem[]
  // Tramos del envio (ej. Bogota -> Cali con un transportador y Cali -> cliente con otro).
  // shippingCost = suma de los tramos; carrierName/carrierSupplierId = el tramo principal (0).
  shippingLegs          DispatchShippingLeg[]
  supplierLedgerEntries SupplierLedgerEntry[]
  shipment              Shipment?

  @@index([orderId])
  @@index([createdById, createdAt])
  @@index([carrierSupplierId])
}

model DispatchItem {
  id           String    @id @default(cuid())
  dispatchId   String
  orderItemId  String
  quantity     Int
  // Porcion del costo de envio asignada a este producto (reparte el total del despacho).
  shippingCost Decimal   @default(0) @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  dispatch     Dispatch  @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([dispatchId])
  @@index([orderItemId])
}

// Un tramo del envio de un despacho: proveedor de transporte + valor (+ guia/nota opcional).
// El tramo 0 es la transportadora principal (la misma de Dispatch.carrierSupplierId).
model DispatchShippingLeg {
  id                String    @id @default(cuid())
  dispatchId        String
  position          Int       @default(0)
  carrierSupplierId String?
  carrierName       String
  amount            Decimal   @default(0) @db.Decimal(12, 2)
  trackingNumber    String?
  note              String?
  legDate           DateTime  @default(now())
  // Pago al transportador de este tramo (cuenta + comprobante).
  supplierPaymentId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  dispatch          Dispatch  @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  carrierSupplier   Supplier? @relation("DispatchShippingLegCarrier", fields: [carrierSupplierId], references: [id], onDelete: SetNull)
  supplierPayment   SupplierLedgerEntry? @relation(fields: [supplierPaymentId], references: [id], onDelete: SetNull)

  @@index([dispatchId, position])
  @@index([carrierSupplierId])
  @@index([supplierPaymentId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String
  createdAt   DateTime     @default(now())
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy   User         @relation("OrderStatusHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([changedById, createdAt])
}

enum AccountType {
  CASH
  BANK
  WALLET
  OTHER
}

enum AccountMovementType {
  IN
  OUT
  TRANSFER
}

model Account {
  id                    String                @id @default(cuid())
  name                  String                @unique
  type                  AccountType           @default(CASH)
  reference             String?
  isActive              Boolean               @default(true)
  openingBalance        Decimal               @default(0) @db.Decimal(14, 2)
  createdById           String
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  createdBy             User                  @relation("AccountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  salePayments          SalePayment[]
  supplierLedgerEntries SupplierLedgerEntry[]
  shippingCosts         ShippingCost[]
  movements             AccountMovement[]
  expenses              Expense[]

  @@index([isActive])
}

model AccountMovement {
  id           String              @id @default(cuid())
  accountId    String
  type         AccountMovementType
  amount       Decimal             @db.Decimal(14, 2)
  note         String?
  transferId   String?
  movementDate DateTime            @default(now())
  createdById  String
  createdAt    DateTime            @default(now())
  account      Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy    User                @relation("AccountMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([accountId, movementDate])
  @@index([transferId])
}

model ExpenseCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   User      @relation("ExpenseCategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  expenses    Expense[]

  @@index([isActive])
}

model Expense {
  id          String          @id @default(cuid())
  categoryId  String
  accountId   String
  amount      Decimal         @db.Decimal(14, 2)
  description String?
  reference   String?
  receiptUrl  String?
  receiptName String?
  expenseDate DateTime        @default(now())
  createdById String
  employeeId  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  category    ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy   User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  employee    User?           @relation("ExpenseEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  borrador    GastoBorrador?

  @@index([categoryId])
  @@index([accountId])
  @@index([employeeId])
  @@index([expenseDate])
}

model InventoryMovement {
  id            String                @id @default(cuid())
  productId     String
  type          InventoryMovementType
  // Efecto con signo sobre el stock: +entrada, -salida, +/- ajuste.
  change        Int
  note          String?
  // Código de compra (COM-00001...) que agrupa los movimientos creados en una
  // misma compra directa a proveedor. Nulo para movimientos sueltos.
  purchaseCode  String?
  movementDate  DateTime              @default(now())
  createdById   String
  createdAt     DateTime              @default(now())
  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy     User                  @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  ledgerEntries SupplierLedgerEntry[]

  @@index([productId, movementDate])
  @@index([purchaseCode])
}

// Cierre de mes: snapshot del resumen de ventas y ganancia de un periodo, que se
// genera manualmente y se comparte por correo (enlace al informe congelado).
model MonthClosure {
  id                String   @id @default(cuid())
  year              Int
  month             Int // 1-12
  periodLabel       String // "junio de 2026"
  salesCount        Int
  salesTotal        Decimal  @db.Decimal(14, 2)
  supplierCosts     Decimal  @db.Decimal(14, 2)
  shippingCosts     Decimal  @db.Decimal(14, 2)
  operatingExpenses Decimal  @db.Decimal(14, 2)
  netProfit         Decimal  @db.Decimal(14, 2)
  marginPct         Decimal  @db.Decimal(6, 2)
  recipients        String // JSON: string[] de correos
  generatedById     String
  generatedBy       User     @relation("MonthClosureGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now())

  @@index([year, month])
}

// Orden de fabricacion (OF-00001): lo que se le encarga a UNA proveedora dentro
// de UNA orden de venta. Tiene numero propio y enlace publico (shareToken) para
// enviarselo; solo cubre los productos de esa orden confirmados con ella.
model ManufacturingOrder {
  id              String    @id @default(cuid())
  code            String    @unique
  orderId         String
  supplierId      String
  shareToken      String    @unique
  deliveryDate    DateTime?
  deliveryAddress String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier        Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([orderId, supplierId])
  @@index([supplierId])
}

// Modulo Transporte: cobertura de envio gratis por ciudad y corregimiento.
// Datos oficiales DANE (DIVIPOLA). El admin marca donde aplica envio gratis y
// el cliente lo consulta en la pagina publica /serviciotransporte.
model TransportDepartment {
  id        String          @id @default(cuid())
  code      String          @unique // Codigo DANE del departamento (2 digitos)
  name      String
  createdAt DateTime        @default(now())
  cities    TransportCity[]
}

// Tipo de envio de una ubicacion. NULL en la ubicacion = comportamiento de siempre
// (freeShipping true -> GRATIS, false -> COTIZAR). ADICIONAL cobra el valor de envio del
// producto (Product.shippingExtra o, si no tiene, Category.shippingExtra).
enum ShippingType {
  GRATIS
  ADICIONAL
  COTIZAR
  NO_LLEGA
}

model TransportCity {
  id           String              @id @default(cuid())
  code         String              @unique // Codigo DANE del municipio (5 digitos)
  departmentId String
  name         String
  freeShipping Boolean             @default(false)
  shippingType ShippingType?
  nameKey      String? // nombre sin acentos y en minusculas (buscar y no duplicar)
  needsReview  Boolean             @default(false)
  source       String              @default("DANE") // DANE | CRM | ADMIN
  createdAt    DateTime            @default(now())
  department   TransportDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  localities   TransportLocality[]
  shipmentsAsDestination Shipment[]      @relation("ShipmentDestination")
  shipmentsAsOrigin      Shipment[]      @relation("ShipmentOrigin")
  shipmentsAsCurrent     Shipment[]      @relation("ShipmentCurrent")
  shipmentEvents         ShipmentEvent[]

  @@index([departmentId])
  @@index([name])
  @@index([nameKey])
}

model TransportLocality {
  id           String        @id @default(cuid())
  code         String        @unique // Codigo DANE del centro poblado (8 digitos) o "CRM-..." si la agrego el CRM
  cityId       String
  name         String
  freeShipping Boolean       @default(false)
  shippingType ShippingType?
  nameKey      String?
  needsReview  Boolean       @default(false)
  source       String        @default("DANE")
  createdAt    DateTime      @default(now())
  city         TransportCity @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
  @@index([name])
  @@index([nameKey])
  @@index([cityId, nameKey])
}

// Guias Magilus (MG-000001): seguimiento propio del envio para el cliente. Cuelga de UN
// despacho (1 a 1). La guia de la transportadora (Dispatch.trackingNumber) queda interna.
enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_WAREHOUSE
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  CANCELLED
}

enum ShipmentEventKind {
  STATUS
  INCIDENT
  NOTE
  ETA_CHANGE
}

enum ShipmentIncident {
  POLICE_INSPECTION
  WEATHER
  HEAVY_TRAFFIC
  ROAD_BLOCK
  VEHICLE_ISSUE
  ADDRESS_ISSUE
  RECIPIENT_ABSENT
  DAMAGE
  OTHER
}

enum ShipmentActor {
  MAGILUS
  CARRIER
  SYSTEM
}

model Shipment {
  id                 String          @id @default(cuid())
  code               String          @unique // MG- + 8 al azar (MG-7K4Q2P8X)
  // Codigo viejo secuencial (MG-000001) de las guias que se recodificaron al azar. Solo sirve
  // para que una busqueda con el numero viejo siga encontrando la guia; en pantalla va `code`.
  legacyCode         String?         @unique
  dispatchId         String          @unique
  status             ShipmentStatus  @default(CREATED)
  destinationCityId  String?
  originCityId       String? // Bogota (fabrica y despacho)
  currentCityId      String?
  estimatedDelivery  DateTime?
  etaIsManual        Boolean         @default(false)
  deliveredAt        DateTime?
  // Cobro al recibir: lo confirma quien crea la guia (sugerido del saldo de la venta).
  collectOnDelivery  Boolean         @default(false)
  amountToCollect    Decimal         @default(0) @db.Decimal(12, 2)
  // Peso del envio en kg (opcional, a mano). Se muestra en la consulta publica.
  weightKg           Decimal?        @db.Decimal(10, 2)
  receivedByName     String?
  deliveryPhotoUrl   String?
  // Consulta publica (magilus.com/guia): guia + ultimos 4 del celular.
  phoneLast4         String?
  publicEnabled      Boolean         @default(true)
  // Enlace del transportador (/envios/t/[token]).
  carrierToken       String          @unique
  carrierTokenActive Boolean         @default(true)
  createdById        String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  dispatch           Dispatch        @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  destinationCity    TransportCity?  @relation("ShipmentDestination", fields: [destinationCityId], references: [id], onDelete: SetNull)
  originCity         TransportCity?  @relation("ShipmentOrigin", fields: [originCityId], references: [id], onDelete: SetNull)
  currentCity        TransportCity?  @relation("ShipmentCurrent", fields: [currentCityId], references: [id], onDelete: SetNull)
  createdBy          User            @relation("ShipmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  events             ShipmentEvent[]

  @@index([status, updatedAt])
  @@index([createdAt])
}

model ShipmentEvent {
  id              String            @id @default(cuid())
  shipmentId      String
  kind            ShipmentEventKind
  status          ShipmentStatus?
  incident        ShipmentIncident?
  note            String?
  cityId          String?
  photoUrl        String?
  newEta          DateTime?
  visibleToClient Boolean           @default(true)
  actor           ShipmentActor
  actorUserId     String?
  actorLabel      String?
  ipHash          String?
  occurredAt      DateTime          @default(now())
  createdAt       DateTime          @default(now())
  shipment        Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  city            TransportCity?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  actorUser       User?             @relation("ShipmentEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([shipmentId, occurredAt])
}

// Limite de intentos de la consulta publica (por IP con hash y por guia).
model ShipmentLookupAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  code      String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([code, createdAt])
}

// Equipo: ficha de cada trabajador (ingreso, salida, contacto, forma de pago).
// Puede no tener usuario (alguien de fabrica que no entra al sistema).
enum TeamEmploymentType {
  FREELANCE
  EMPLEADO
  OTRO
}

enum TeamPayType {
  QUINCENAL
  DIARIO
  SOLO_COMISION
}

model TeamMember {
  id             String             @id @default(cuid())
  // Usuario de Gestion (opcional, unico). Si se borra el usuario la ficha queda sin enlace.
  userId         String?            @unique
  fullName       String
  // Nombre sin tildes y en minusculas, para buscar.
  nameKey        String
  document       String?
  birthDate      DateTime?          @db.Date
  phone          String?
  email          String?
  address        String?
  emergencyName  String?
  emergencyPhone String?
  // Cargo en lenguaje libre: Asesora, Produccion, Dueno...
  jobTitle       String?
  isOwner        Boolean            @default(false)
  employmentType TeamEmploymentType @default(FREELANCE)
  payType        TeamPayType?
  startDate      DateTime?          @db.Date
  // Ultimo dia trabajado. Con la fecha ya pasada la persona queda Retirada (el estado no se guarda).
  endDate        DateTime?          @db.Date
  exitReason     String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User?              @relation("TeamMemberUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([endDate])
  @@index([nameKey])
}

// Asistencia: registro de entrada y salida de cada trabajador (oct-2026).
// La hora la pone el servidor; las marcas no se borran: una correccion anula la original
// y crea otra con origen CORRECCION (quien, cuando y por que).
enum AsistenciaTipo {
  ENTRADA
  SALIDA
}

enum AsistenciaOrigen {
  PROPIA
  ADMIN
  CORRECCION
}

model AsistenciaMarca {
  id              String           @id @default(cuid())
  userId          String
  tipo            AsistenciaTipo
  // Hora real de la marca (la pone el servidor; en correcciones, la que escribe el admin).
  marcadaEn       DateTime         @default(now())
  // Dia en Colombia al que pertenece (el de la entrada, aunque la salida pase de medianoche).
  dia             DateTime         @db.Date
  origen          AsistenciaOrigen @default(PROPIA)
  creadaPorId     String?
  // Obligatorio en correcciones.
  motivo          String?
  // Marca que esta reemplaza (correccion).
  corrigeAId      String?
  anuladaEn       DateTime?
  anuladaPorId    String?
  motivoAnulacion String?
  createdAt       DateTime         @default(now())
  user            User             @relation("AsistenciaMarcaUsuario", fields: [userId], references: [id], onDelete: Restrict)
  creadaPor       User?            @relation("AsistenciaMarcaCreadaPor", fields: [creadaPorId], references: [id], onDelete: SetNull)
  anuladaPor      User?            @relation("AsistenciaMarcaAnuladaPor", fields: [anuladaPorId], references: [id], onDelete: SetNull)

  @@index([userId, dia])
  @@index([dia])
}

enum GastoBorradorEstado {
  PENDIENTE
  GUARDADO
  RECHAZADO
  VENCIDO
}

// Gasto dicho a Claude (MCP) que espera la foto del soporte. El token del enlace nunca se guarda:
// solo su hash. Al pasar la revision de la foto se crea el Expense y el borrador queda GUARDADO.
model GastoBorrador {
  id                  String              @id @default(cuid())
  tokenHash           String              @unique
  categoryId          String
  accountId           String
  amount              Decimal             @db.Decimal(14, 2)
  expenseDate         DateTime
  description         String?
  motivoRetroactivo   String?
  employeeId          String?
  estado              GastoBorradorEstado @default(PENDIENTE)
  intentos            Int                 @default(0)
  ultimoMotivoRechazo String?
  // Lo que dijo la IA de la ultima foto: tipo de soporte y monto leido.
  revision            Json?
  expenseId           String?             @unique
  createdById         String
  creadoEn            DateTime            @default(now())
  expiraEn            DateTime
  createdBy           User                @relation("GastoBorradorCreadoPor", fields: [createdById], references: [id], onDelete: Restrict)
  expense             Expense?            @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([estado, expiraEn])
}

// Dudas del catalogo (oct-2026): preguntas sobre los productos que responden las asesoras en
// /dudas, entrando con su nombre y un codigo (AccesoDudas). Se migraron de la encuesta de claude.ai.
// id = el doc_id de la encuesta (ej. "q001").
model DudaCatalogo {
  id         String          @id
  codigo     String?
  // nombre | duplicado | categoria | foto | separar | negocio | descripcion | sincronizar_igual | sincronizar_eliminar | sincronizar_cargar
  grupo      String
  titulo     String
  duda       String          @default("")
  orden      Int             @default(0)
  // [[etiqueta, valor], ...]
  datos      Json
  // [{ id, label, texto? }, ...] (texto = placeholder del detalle que se pide escribir)
  opciones   Json
  // [{ label, url }, ...]
  links      Json
  // Campos de mas que traiga la pregunta (ej. fotos).
  extra      Json?
  activa     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  respuestas RespuestaDuda[]

  @@index([grupo, orden])
}

// Historial: cada guardado crea una fila. La ultima (createdAt) es la vigente.
model RespuestaDuda {
  id          String        @id @default(cuid())
  dudaId      String
  opcionId    String
  // Etiqueta de la opcion al momento de responder.
  opcionTexto String        @default("")
  // Detalle escrito (cuando la opcion lo pide).
  texto       String        @default("")
  nota        String        @default("")
  autorNombre String
  accesoId    String?
  createdAt   DateTime      @default(now())
  duda        DudaCatalogo  @relation(fields: [dudaId], references: [id], onDelete: Cascade)
  acceso      AccesoDudas?  @relation(fields: [accesoId], references: [id], onDelete: SetNull)

  @@index([dudaId, createdAt])
  @@index([createdAt])
}

// Acceso a /dudas: nombre de la persona + codigo de 6 caracteres. Solo se guarda el hash (bcrypt).
model AccesoDudas {
  id         String          @id @default(cuid())
  nombre     String
  codigoHash String
  activo     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  ultimoUso  DateTime?
  respuestas RespuestaDuda[]

  @@index([activo])
}
